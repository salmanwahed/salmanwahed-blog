DJANGO_SECRET_KEY=your-secret-key-here

# Set to TRUE for local development. DEBUG is what adds 127.0.0.1 and localhost
# to ALLOWED_HOSTS -- without it, runserver answers every request with 400.
# (Placing a credentials.txt file in the repo root turns DEBUG on as well.)
DJANGO_DEBUG=TRUE

DB_NAME=salmanwahed_db
DB_USER=salmanwahed
DB_PASSWORD=your-db-password
DB_HOST=db
DB_PORT=5432

# Optional
CDN_URL=
USE_CDN=FALSE
WPM_READ=180
SENTRY_DSN=
SERVER_IP=

# Contact form. Only needed in production -- with DEBUG on, mail is printed
# to the console and none of the EMAIL_* values are read.
CONTACT_EMAIL=hello@salmanwahed.com
CONTACT_RATE_LIMIT=5
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=TRUE
